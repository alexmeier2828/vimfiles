{
	"zig.enabled": true,
	"zig.startUpMessage": true,
	"zig.path": "zls",
	"zig.debugLog": false,

	"inlayHint.display": false,
	"suggest.noselect": true,
	"languageserver": {
		"lua": {
			"command": "/usr/bin/lua-language-server",
			"filetypes": ["lua"],
			"settings": {
				"Lua.diagnostics.globals":  [ "vim" ]
			}
		}
	},
}
